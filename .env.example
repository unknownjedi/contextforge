# ==============================================================================
# ContextForge Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting services.
# Both CF_ prefixed variables and standard short names are supported.
# ==============================================================================

# Application Environment (development, test, production)
CF_SERVER_ENV=development
APP_ENV=development
PORT=8080
CF_SERVER_PORT=8080
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# Frontend Next.js API Base URL (used by web app)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------
# PostgreSQL connection string with pgvector extension enabled
CF_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/contextforge?sslmode=disable
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/contextforge?sslmode=disable

# Redis connection string for Asynq job queue and distributed locking
CF_REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Database connection pool settings
CF_DATABASE_MAX_OPEN_CONNS=25
DB_MAX_OPEN_CONNS=25
CF_DATABASE_MAX_IDLE_CONNS=10
DB_MAX_IDLE_CONNS=10

# ------------------------------------------------------------------------------
# Security & Cryptography
# ------------------------------------------------------------------------------
# Session signing secret (minimum 32 characters, change in production)
CF_AUTH_JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# AES-256-GCM encryption key for encrypting GitHub tokens at rest in PostgreSQL
# Must be exactly 32 bytes (64 hex characters)
CF_AUTH_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session expiration
CF_AUTH_SESSION_EXPIRY=72h

# ------------------------------------------------------------------------------
# GitHub Integration
# ------------------------------------------------------------------------------
# Option A: GitHub App (Recommended for multi-user / production)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Option B: GitHub Personal Access Token (PAT) Fallback (for rapid local experimentation)
# If provided, bypasses GitHub App requirement for repository discovery & cloning
GITHUB_PAT=

# ------------------------------------------------------------------------------
# Embedding Provider Configuration
# ------------------------------------------------------------------------------
# Options: "openai", "gemini", "ollama", "mock"
CF_PROVIDERS_DEFAULTS_EMBEDDING=openai
EMBEDDING_PROVIDER=openai

# Model name corresponding to provider:
# - openai: text-embedding-3-small (1536 dim), text-embedding-3-large (3072 dim)
# - gemini: text-embedding-004 (768 dim)
# - ollama: nomic-embed-text (768 dim), bge-small-en-v1.5 (384 dim)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# Cloud API Keys (BYOK)
CF_PROVIDERS_API_KEYS_OPENAI=
OPENAI_API_KEY=
CF_PROVIDERS_API_KEYS_GEMINI=
GEMINI_API_KEY=
CF_PROVIDERS_API_KEYS_VOYAGE=
VOYAGE_API_KEY=

# Local Ollama endpoint (if EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# LLM Generation Provider Configuration
# ------------------------------------------------------------------------------
# Options:
# - Cloud BYOK: "openai", "anthropic", "gemini", "ollama", "mock"
# - Local CLI Bridge: "cli_opencode", "cli_claude", "cli_gemini", "cli_codex"
CF_PROVIDERS_DEFAULTS_LLM=cli_opencode
LLM_PROVIDER=cli_opencode

# Model name (e.g. gpt-4o, gpt-4o-mini, claude-3-5-sonnet-20241022, gemini-1.5-pro)
LLM_MODEL=default
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Cloud API Keys for generation (if using cloud BYOK)
CF_PROVIDERS_API_KEYS_ANTHROPIC=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Background Worker Settings
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=10
WORKER_QUEUES=critical:6,default:3,low:1

# ------------------------------------------------------------------------------
# Telemetry & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=info # debug, info, warn, error
LOG_FORMAT=json # json, text
